[Unit]
Description=Cloud Farm Backend - FastAPI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cloud-farm/backend

EnvironmentFile=/opt/cloud-farm/backend/.env
ExecStart=/opt/cloud-farm/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
